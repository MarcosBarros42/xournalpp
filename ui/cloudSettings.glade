<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with love by the xournalpp fork -->
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkScrolledWindow" id="cloudSettingsPanel">
    <property name="visible">True</property>
    <property name="can-focus">True</property>
    <property name="min-content-width">500</property>
    <property name="min-content-height">300</property>
    <child>
      <object class="GtkViewport">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="vexpand">True</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkFrame" id="frameCloudAccount">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label-xalign">0.009999999776482582</property>
                <child>
                  <object class="GtkBox" id="cloudAccountBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel" id="lbCloudStatus">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="halign">start</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">60</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButtonBox" id="cloudButtonBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="halign">start</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkButton" id="btnCloudRefresh">
                            <property name="label" translatable="yes">Atualizar status</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btnCloudLogin">
                            <property name="label" translatable="yes">Login com Google Drive</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btnCloudSyncNow">
                            <property name="label" translatable="yes">Sincronizar agora</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btnCloudLogout">
                            <property name="label" translatable="yes">Logout</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbCloudPathInfo">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="halign">start</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">60</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Google Drive (nuvem, fork)</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="label_item">
              <placeholder/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
